---
import ThemeEditor from "~/components/theme/ThemeEditor.svelte";
import SiteDocsShell from "~/components/docs/SiteDocsShell.svelte";
import Base from "~/layouts/Base.astro";
import { SECTIONS } from "~/lib/nav";
---
<Base
	title="Theme editor"
	description="Pick a brand color, tune radius, blur and surface style, preview every component live, and export the CSS tokens for @codeatlasdev/ui."
>
	<SiteDocsShell client:load sections={SECTIONS} active="theme" pathname={Astro.url.pathname}>
		<div id="main" tabindex="-1">
			<ThemeEditor client:load />
		</div>
	</SiteDocsShell>
</Base>
